# Pairs to record, comma separated. Fetched in a single batched request per tick,
# so adding symbols costs no extra requests. Stablecoin pairs are worth recording
# for the peg itself: USDCUSDT sits near 1.0 and its deviation is the signal.
WATCHLIST=SOLUSDT,BTCUSDT,ETHUSDT,USDCUSDT

# Other venues, one list each. A venue with no list is not polled. The same
# pair on two venues becomes two independent series, compared with --venues.
#
# PAIR:VENUE_PAIR records under the first name and asks the venue for the
# second, which is how the same market lines up across exchanges that name it
# differently. Coinbase has no SOL-USDC - USD and USDC are interchangeable
# there, so SOL-USD is that book.
#
# Verify before adding:  python3 recorder.py --probe SOLUSDC SOLUSDC:SOLUSD
#WATCHLIST_COINBASE=SOLUSDC:SOLUSD
#WATCHLIST_KRAKEN=SOLUSDC
#WATCHLIST_OKX=SOLUSDC
#WATCHLIST_BYBIT=SOLUSDC

# Seconds between ticks. Ticks are aligned to the wall clock, so 60 records at
# :00 of every minute and the loop never drifts.
INTERVAL_SEC=60

DB_PATH=/home/ubuntu/.config/oakring/ring.db
BINANCE_URL=https://api.binance.com/api/v3/ticker/bookTicker

# Per-request timeout, and how many times a failed tick is retried (with
# exponential backoff) before it is written to the database as an error row.
HTTP_TIMEOUT_SEC=15
MAX_RETRIES=2

# Delete ticks older than this many days, checked hourly. 0 keeps everything -
# cycle analysis wants history, so only set this if disk is a concern.
RETENTION_DAYS=0

# DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Optional on-chain reference via Jupiter public quote API (read-only, no swap).
# When enabled, one quote is fetched per recorder tick and stored on the listed
# CEX pairs next to the Binance mid so basis = (cex_mid - onchain_ref) / onchain_ref
# is available at tick resolution (~1s if INTERVAL_SEC=1).
#JUPITER_ENABLED=1
#JUPITER_ATTACH_PAIRS=SOLUSDT,SOLUSDC
# Per-pool samples: one parallel quote per DEX per tick (SOL/USDC or SOL/USDT per pair).
#JUPITER_DEXES=Raydium,Orca,Meteora DLMM
#JUPITER_ONLY_DIRECT_ROUTES=1
#JUPITER_QUOTE_URL=https://quote-api.jup.ag/v6/quote
#JUPITER_INPUT_MINT=So11111111111111111111111111111111111111112
#JUPITER_OUTPUT_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
#JUPITER_USDT_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
#JUPITER_AMOUNT_LAMPORTS=1000000000
#JUPITER_SLIPPAGE_BPS=50
#JUPITER_INPUT_DECIMALS=9
#JUPITER_OUTPUT_DECIMALS=6
#JUPITER_API_KEY=...   # only if your deployment requires it; never commit

# Alerts. Configure at least one destination to be told when the recording
# breaks or recovers. Nothing is sent while everything is healthy.
# This file is mode 600 because a bot token is a credential.
#ALERT_TELEGRAM_TOKEN=123456:ABCdef...
#ALERT_TELEGRAM_CHAT_ID=987654321
#ALERT_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
#ALERT_WEBHOOK=https://example.test/hook
# Re-notify this often while a problem persists (0 = only on change).
ALERT_REPEAT_HOURS=6
